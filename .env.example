# Google Gemini API key for the optional AI insights tool.
# Used only by the Node server (never sent to the browser). Leave empty to disable AI features.
GEMINI_API_KEY=

# Optional: Gemini model id (default: gemini-3.6-flash).
GEMINI_MODEL=

# Optional server settings.
PORT=3000
# Defaults to 127.0.0.1 in development and 0.0.0.0 when NODE_ENV=production.
HOST=
